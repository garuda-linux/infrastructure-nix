{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": [
    "dr460nf1r3"
  ],
  "commitMessageAction": "update",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    "group:recommended"
  ],
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true,
    "extends": [
      "schedule:weekly"
    ]
  },
  "nix": {
    "enabled": true
  },
  "reviewersFromCodeOwners": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pkgs/garuda-website/default\\.nix$/"
      ],
      "matchStrings": [
        "rev = \"(?<currentDigest>[0-9a-f]{40})\";"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "garuda-website",
      "packageNameTemplate": "https://gitlab.com/garuda-linux/website/website-catppuccin",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pkgs/garuda-startpage/default\\.nix$/"
      ],
      "matchStrings": [
        "rev = \"(?<currentDigest>[0-9a-f]{40})\";"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "garuda-startpage",
      "packageNameTemplate": "https://gitlab.com/garuda-linux/website/startpage-v2",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Image pins in Nix files, marked with a `# renovate: datasource=... depName=...` comment",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[\\w-]+ = \"[^\":]+:(?<currentValue>[^\"]+)\";"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "garuda-website",
        "garuda-startpage"
      ],
      "postUpgradeTasks": {
        "commands": [
          "./scripts/update-website-hashes.sh"
        ],
        "fileFilters": [
          "pkgs/**"
        ],
        "executionMode": "update"
      }
    }
  ]
}
