      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Status codes",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
