                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${lokidatasource}"
                      },
                      "spec": {
                        "expr": "topk(15, sum by (vhost) (count_over_time({service=\"nginx-access\"}[$__range])))",
                        "format": "table",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
