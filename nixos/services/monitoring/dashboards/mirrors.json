                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "count((max by (instance) (mirror_upstream_last_sync_timestamp_seconds{job=~\"$group\", instance=~\"$instance\", repo=\"chaotic-aur\"}) - max by (instance) (mirror_last_sync_timestamp_seconds{job=~\"$group\", instance=~\"$instance\", repo=\"chaotic-aur\"})) > 1800 or max by (instance) (mirror_upstream_last_sync_timestamp_seconds{job=~\"$group\", instance=~\"$instance\", repo=\"chaotic-aur\"} == 0)) or vector(0)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
