                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Fleet status",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (instance, fqdn, version, revision) (mirror_info{job=~\"$group\", instance=~\"$instance\"})",
                        "format": "table",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (instance) (mirror_packages_total{job=~\"$group\", instance=~\"$instance\", repo=~\"$repo\"})",
                        "format": "table",
                        "instant": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "(max by (instance) (mirror_upstream_last_sync_timestamp_seconds{job=~\"$group\", instance=~\"$instance\", repo=\"chaotic-aur\"}) - max by (instance) (mirror_last_sync_timestamp_seconds{job=~\"$group\", instance=~\"$instance\", repo=\"chaotic-aur\"})) / 3600",
                        "format": "table",
                        "instant": true
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "(max by (instance) (mirror_upstream_last_sync_timestamp_seconds{job=~\"$group\", instance=~\"$instance\", repo=\"garuda\"}) - max by (instance) (mirror_last_sync_timestamp_seconds{job=~\"$group\", instance=~\"$instance\", repo=\"garuda\"})) / 3600",
                        "format": "table",
                        "instant": true
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value #A": true,
                        "__name__": true,
                        "job": true,
                        "repo": false
                      },
                      "renameByName": {
                        "Value #A": "Info",
                        "Value #B": "Packages",
                        "Value #C": "Chaotic lag vs upstream (h)",
                        "Value #D": "Garuda lag vs upstream (h)",
                        "fqdn": "FQDN",
                        "instance": "Host",
                        "revision": "Revision",
                        "version": "NixOS"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
