            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "exemplar": true,
                        "expr": "dovecot_imap_command_duration_seconds_total{instance=\"$instance\"} - dovecot_imap_command_duration_seconds_total{instance=\"$instance\"} offset $__interval",
                        "interval": "$__interval",
                        "legendFormat": "{{cmd_name}}{{tagged_reply_state}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "exemplar": true,
                        "expr": "dovecot_imap_command_duration_seconds_sum{instance=\"$instance\"} - dovecot_imap_command_duration_seconds_sum{instance=\"$instance\"} offset $__interval",
                        "interval": "$__interval",
                        "legendFormat": "All commands"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
